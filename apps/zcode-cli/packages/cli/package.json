{
  "name": "@social-harness/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Internal headless Agent runtime used by Social Harness desktop and server hosts",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/social-harness.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --no-ignore",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@social-harness/adapters": "workspace:*",
    "@social-harness/bootstrap": "workspace:*",
    "@social-harness/contracts": "workspace:*",
    "@social-harness/core": "workspace:*",
    "@social-harness/dynamic-workflow-runtime": "workspace:*",
    "@social-harness/i18n": "workspace:*",
    "@social-harness/provider-node": "workspace:*",
    "@social-harness/shared": "workspace:*",
    "@social-harness/shared-types": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
