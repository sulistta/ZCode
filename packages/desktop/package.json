{
  "name": "@social-harness/desktop",
  "version": "3.14.0",
  "private": true,
  "description": "Social Harness Desktop App",
  "author": "Social Harness",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "pre-dev": "node scripts/ensure-local-runtime-assets.mjs && node -e \"require('node:fs').rmSync('./out',{recursive:true,force:true})\"",
    "dev": "node ../../scripts/dev-desktop-env.mjs production",
    "pre-dev:local-cli": "pnpm --dir ../.. exec node scripts/build-desktop-agent-cli.mjs && node -e \"require('node:fs').rmSync('./out',{recursive:true,force:true})\"",
    "dev:local-cli": "pnpm pre-dev:local-cli && concurrently -k -n tsup,vite,electron \"tsup --watch src --watch ../services/src --watch ../server/src --watch ../shared/src --watch ../rpc/src --watch ../client/src --watch ../provider/src --watch ../provider-node/src --ignore-watch 'mock-cdn/**' --ignore-watch 'bundled-agents/**' --ignore-watch '.e2e-cache/**' --ignore-watch '.e2e-artifacts/**' --ignore-watch '.e2e-home-*/**' --ignore-watch 'dist-cua-helper/**'\" \"vite dev\" \"node scripts/dev.mjs\"",
    "dev:runtime": "concurrently -k -n tsup,vite,electron \"tsup --watch src --watch ../services/src --watch ../server/src --watch ../shared/src --watch ../rpc/src --watch ../client/src --watch ../provider/src --watch ../provider-node/src --ignore-watch 'mock-cdn/**' --ignore-watch 'bundled-agents/**' --ignore-watch '.e2e-cache/**' --ignore-watch '.e2e-artifacts/**' --ignore-watch '.e2e-home-*/**' --ignore-watch 'dist-cua-helper/**'\" \"vite dev\" \"node scripts/dev.mjs\"",
    "prepare:build-meta": "node scripts/build-metadata.mjs",
    "prepare:runtime-assets": "node scripts/prepare-runtime-assets.mjs",
    "prepare:remote-assets": "node ../../scripts/prepare-prebuilds.mjs",
    "prepare:agent-bundle": "node scripts/prepare-agent-node-bundle.mjs",
    "prepare:social-media-tools": "node scripts/prepare-social-media-tools.mjs",
    "prepare:ffmpeg-runtime": "node scripts/prepare-ffmpeg-runtime.mjs",
    "prepare:whisper-runtime": "node scripts/prepare-whisper-runtime.mjs",
    "prepare:native-search": "node ../../scripts/prepare-native-search-tools.mjs",
    "prepare:browser-import-helper": "node scripts/build-windows-browser-import-helper.mjs",
    "prepare:macos-window-bounds": "node scripts/build-macos-window-bounds.mjs",
    "build:no-runtime-assets": "pnpm prepare:build-meta && pnpm prepare:convex-provisioner && node scripts/run-production-build.mjs",
    "build": "pnpm prepare:runtime-assets && pnpm run build:no-runtime-assets",
    "bundle": "node scripts/bundle.mjs",
    "audit:bundle-size": "node scripts/audit-bundle-size.mjs",
    "test:deep-links": "node --experimental-test-module-mocks --import tsx --test src/main/desktopDeepLinkUrl.test.ts src/main/desktopOAuthCallbackRouter.test.ts src/main/desktopOAuthDeepLink.test.ts src/main/desktopSecondInstanceDeepLink.test.ts src/main/desktopLegacyOpenFolderCleanup.test.ts src/main/startupWorkspace.test.ts src/main/about.test.ts src/main/windowsCuaOperationIndicatorContent.test.ts",
    "test:social-harness-e2e": "node --import tsx test/socialHarnessAccountE2E.mjs",
    "test:preview-proxy-e2e": "node --import tsx test/socialMediaPreviewProxySmokeE2E.mjs",
    "test:instagram-setup-e2e": "node test/socialInstagramSetupE2E.mjs",
    "test:convex-runtime": "node test/convexProvisionerRuntimeSmoke.mjs",
    "test:packaged-preview-smoke": "node test/socialHarnessPackagedPreviewSmoke.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare:convex-provisioner": "node scripts/prepare-convex-provisioner.mjs"
  },
  "dependencies": {
    "@arms/rum-electron": "^0.0.3",
    "@babel/runtime": "^7.24.5",
    "@fiahfy/icns": "^0.0.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.214.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.214.0",
    "@opentelemetry/resources": "2.6.1",
    "@opentelemetry/sdk-metrics": "2.6.1",
    "@opentelemetry/sdk-trace-base": "2.6.1",
    "@social-harness/client": "workspace:*",
    "@social-harness/provider": "workspace:*",
    "@social-harness/provider-node": "workspace:*",
    "@social-harness/rpc": "workspace:*",
    "@social-harness/server": "workspace:*",
    "@social-harness/services": "workspace:*",
    "@social-harness/shared": "workspace:*",
    "@social-harness/ui": "workspace:*",
    "@social-harness/zcode-cua": "workspace:*",
    "electron-updater": "^6.8.3",
    "module-details-from-path": "^1.0.4",
    "node-forge": "^1.4.0",
    "playwright-core": "1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "^7.7.4",
    "ssh2": "^1.16.0",
    "undici": "^6.23.0",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "41.0.3",
    "electron-builder": "^26.15.3",
    "http-mitm-proxy": "^1.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  },
  "productName": "Social Harness"
}
